#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

source scripts/check-tool-version.sh

check_tool_version cargo-nextest 0.9.131 "$(cargo-nextest nextest --version)"
check_tool_version cargo-deny 0.20.2 "$(cargo deny --version)"
check_tool_version cargo-hack 0.6.45 "$(cargo hack --version)"


# Genuine compiler suites fail closed when unprovisioned. Provision for local
# quality runs as well as CI; CI performs its authenticated download separately.
if [[ -z "${BEND2_COMPILER_TEST_PATH:-}" ]]; then
    BEND_BOOTSTRAP_ROOT="$(mktemp -d "${TMPDIR:-/tmp}/bend2-quality-compiler.XXXXXX")"
    trap 'rm -rf "$BEND_BOOTSTRAP_ROOT"' EXIT
    python3 scripts/bootstrap_bend.py --destination "$BEND_BOOTSTRAP_ROOT/bend" --github-env "$BEND_BOOTSTRAP_ROOT/environment"
    while IFS='=' read -r name value; do
        export "$name=$value"
    done < "$BEND_BOOTSTRAP_ROOT/environment"
fi
test -f "$BEND2_COMPILER_TEST_PATH"
export BEND_NO_TELEMETRY=1
printf '== policy ==\n'
python3 scripts/check-policy.py
python3 -m unittest discover -s scripts -p test_check_policy.py
python3 -m unittest discover -s scripts -p test_tool_versions.py
printf '== workflow security ==\n'
./scripts/check-workflows
printf '== Rust performance infrastructure contract tests ==\n'
cargo test --package bend2-perf --all-features --locked
printf '== release integrity ==\n'
python3 -m unittest discover -s scripts -p test_release.py
printf '== semantic supervisor contract tests ==\n'
python3 -m unittest discover -s scripts -p 'test_semantic*.py'
python3 -m unittest discover -s scripts -p test_bootstrap_bend_lint.py

printf '== format ==\n'
cargo fmt --all -- --check

printf '== rustc ==\n'
cargo check --workspace --all-targets --all-features --locked

printf '== clippy (all targets; test panic helpers permitted) ==\n'
cargo clippy --workspace --all-targets --all-features --locked -- \
    -D warnings -A clippy::unwrap_used -A clippy::expect_used

printf '== clippy (production binary; panic helpers denied) ==\n'
cargo clippy --package bend2-lsp --bin bend2-lsp --all-features --locked -- -D warnings
cargo clippy --package bend2-perf --bin bend2-perf --all-features --locked -- -D warnings
cargo clippy --package tower-lsp --lib --all-features --locked -- -D warnings

printf '== tests ==\n'
cargo nextest run --workspace --exclude bend2-perf --all-features --locked --profile ci
cargo test --package tower-lsp --all-features --locked --doc

printf '== feature combinations ==\n'
cargo hack check --workspace --feature-powerset --locked

printf '== dependencies ==\n'
cargo deny check --deny index-failure

# CI provisions with a step-scoped download token before this script. Keep cold
# local runs self-contained without replacing CI's recorded installation cost.
if [[ "${GITHUB_ACTIONS:-}" != "true" ]]; then
    printf '== pinned semantic runtime installation ==\n'
    python3 scripts/semantic_gate.py install
fi

printf '== semantic tools and candidate preparation (separately measured) ==\n'
python3 scripts/semantic_gate.py setup
printf '== required bounded semantic conformance ==\n'
python3 scripts/semantic_gate.py run
