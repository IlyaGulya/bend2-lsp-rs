+#[cfg(test)]
+mod bend2_arm64_regressions {
+    use super::*;
+
+    fn context() -> ProfileContext {
+        let props = ProfileCreationProps {
+            profile_name: None,
+            fallback_profile_name: "ARM64 SampleProf regression".into(),
+            main_thread_only: false,
+            reuse_threads: false,
+            fold_recursive_prefix: false,
+            unlink_aux_files: false,
+            create_per_cpu_threads: false,
+            arg_count_to_include_in_process_name: 0,
+            override_arch: None,
+            unstable_presymbolicate: false,
+            coreclr: Default::default(),
+            unknown_event_markers: false,
+            time_range: None,
+            should_emit_jit_markers: false,
+            should_emit_cswitch_markers: false,
+        };
+        let profile = Profile::new(
+            "ARM64 SampleProf regression",
+            fxprof_processed_profile::ReferenceTimestamp::from_millis_since_unix_epoch(0.0),
+            SamplingInterval::from_nanos(1_000_000),
+        );
+        let mut context = ProfileContext::new(profile, "arm64", None, props);
+        context.handle_header(0, 10_000_000, 1);
+        context.handle_process_start(0, 8888, 0, "bend2-lsp.exe".into(), String::new());
+        context.handle_thread_start(0, 10708, 8888, None);
+        context
+    }
+
+    #[test]
+    fn arm64_sampleprof_preserves_cpu_delta_and_split_kernel_user_stacks() {
+        let mut context = context();
+        context.handle_sample(1000, 10708, 0);
+        context.handle_stack_arm64(1000, 8888, 10708, [0x7ffa944f2e74].into_iter());
+        context.handle_sample(2000, 10708, 0);
+        context.handle_stack_arm64(2000, 8888, 10708, [0xfffff8009a06c428].into_iter());
+        // The kernel half alone must not emit a second sample or lose its CPU delta.
+        assert_eq!(context.stack_sample_count, 1);
+        context.handle_stack_arm64(2000, 8888, 10708, [0x7ffa944f2e74].into_iter());
+        assert!(context.threads.get_by_tid(10708).unwrap().samples_with_pending_stacks.is_empty());
+        let profile = serde_json::to_value(context.finish()).unwrap();
+        let thread = &profile["threads"][0];
+        assert_eq!(thread["pid"], "8888");
+        assert_eq!(thread["samples"]["length"], 2);
+        assert_eq!(thread["samples"]["weight"], serde_json::json!([1, 1]));
+        assert_eq!(thread["samples"]["threadCPUDelta"], serde_json::json!([0, 100]));
+        let stack = thread["samples"]["stack"][1].as_u64().unwrap() as usize;
+        assert!(thread["stackTable"]["prefix"][stack].as_u64().is_some());
+    }
+
+    #[test]
+    fn arm64_stack_requires_matching_event_timestamp_and_process() {
+        let mut context = context();
+        context.handle_stack_arm64(500, 8888, 10708, [0x7ffa944f2e74].into_iter());
+        context.handle_sample(1000, 10708, 0);
+        context.handle_stack_arm64(1000, 9999, 10708, [0x7ffa944f2e74].into_iter());
+        context.handle_stack_arm64(1001, 8888, 10708, [0x7ffa944f2e74].into_iter());
+        assert_eq!(context.stack_sample_count, 0);
+        assert_eq!(context.threads.get_by_tid(10708).unwrap().samples_with_pending_stacks.len(), 1);
+        context.handle_stack_arm64(1000, 8888, 10708, [0x7ffa944f2e74].into_iter());
+        assert_eq!(context.stack_sample_count, 1);
+    }
+}
